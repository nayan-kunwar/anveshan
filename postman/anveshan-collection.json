                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Changes (public)",
      "item": [
        {
          "name": "List changes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/programs/{{programId}}/changes?page=1&pageSize=100",
            "description": "Change history for one program, detected_at DESC."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('has data + pagination', () => { pm.expect(pm.response.json()).to.have.property('data'); });"

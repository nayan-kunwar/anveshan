{
  "info": {
    "name": "Anveshan API",
    "description": "Postman collection for the Anveshan API (docs/openapi.yaml is the source of truth).\n\nRun order: 1. Health -> 2-4 public reads (any order) -> 5 Auth (paste the magic-link token to establish a session) -> 6 Subscription -> 7-8 Admin (set the adminKey environment variable first).\n\nEnvironment variables: baseUrl + adminKey (set in the active environment); programId, runId, userId, magicToken, testEmail, unsubscribeToken (collection variables, chained automatically where possible).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "programId", "value": "" },
    { "key": "runId", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "magicToken", "value": "" },
    { "key": "testEmail", "value": "anveshan-test@yopmail.com" },
    { "key": "unsubscribeToken", "value": "" }
  ],
  "item": [
    {
      "name": "1. Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Liveness check. No auth."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('body is {status: ok}', () => { pm.expect(pm.response.json()).to.eql({ status: 'ok' }); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Programs (public)",
      "item": [
        {
          "name": "List programs",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/programs?page=1&pageSize=25",
            "description": "Paginated program list. Chains the first program's id into the programId collection variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('has data + pagination', () => { pm.expect(json).to.have.property('data'); pm.expect(json).to.have.property('pagination'); });",
                  "if (Array.isArray(json.data) && json.data.length > 0) { pm.collectionVariables.set('programId', json.data[0].id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "List programs (search + small page)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/programs?q=a&pageSize=5",
            "description": "Free-text filter q, pageSize 5."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Get program (chained id)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/programs/{{programId}}",
            "description": "Run 'List programs' first (it sets programId). :id is the internal UUID, not the HackerOne handle."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('body has data.id', () => { pm.expect(pm.response.json().data).to.have.property('id'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get program - not found",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/programs/99999999-9999-9999-9999-999999999999",
            "description": "Valid UUID that does not exist."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));",
                  "pm.test('code PROGRAM_NOT_FOUND', () => { pm.expect(pm.response.json().error.code).to.eql('PROGRAM_NOT_FOUND'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject pageSize over max",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/programs?page=1&pageSize=101",
            "description": "pageSize max is 100."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('code BAD_REQUEST', () => { pm.expect(pm.response.json().error.code).to.eql('BAD_REQUEST'); });"
                ]
              }
            }
          ]
        }
      ]
    },

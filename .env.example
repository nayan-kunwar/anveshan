# Anveshan — environment template
# Copy to .env and fill. Never commit .env.

# --- Database ---
DATABASE_URL=postgres://anveshan:anveshan@localhost:5433/anveshan

# --- HackerOne (Hacker API v1) ---
# https://hackerone.com/settings/api_token
HACKERONE_USERNAME=
HACKERONE_API_TOKEN=
# Base override (tests/staging only, default https://api.hackerone.com/v1/hackers)
H1_BASE_URL=https://api.hackerone.com/v1/hackers
H1_MIN_DELAY_MS=1500
H1_MAX_CONCURRENCY=1
H1_TIMEOUT_MS=15000

# --- Collection scheduler ---
COLLECTION_CRON=*/30 * * * *
COLLECTION_TZ=UTC
COLLECTION_ENABLED=true
# Mark collection_runs.status=running older than this as failed (default 2h)
COLLECTION_STALE_RUNNING_MS=7200000

# --- API ---
PORT=3000
LOG_LEVEL=info

# --- Milestone 2: notifications + magic-link auth ---
# SMTP (Gmail is local-only; use Resend/Postmark/SES in production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@anveshan.dev
# Auth secrets (optional at boot; fail-closed per endpoint)
MAGIC_LINK_SECRET=
MAGIC_LINK_EXPIRY=900000
SESSION_SECRET=
SESSION_EXPIRY=2592000000
UNSUBSCRIBE_SECRET=
FRONTEND_URL=http://localhost:3001
NOTIFICATIONS_ENABLED=false
# AUTH_EMAIL_ENABLED unset = derived (true when SMTP_HOST+SMTP_USER+SMTP_PASS set)
AUTH_EMAIL_ENABLED=
DAILY_DIGEST_CRON=0 8 * * *
IMMEDIATE_EMAIL_CAP=20
ASSET_EMAIL_CAP=10

# --- Live test gate (never enable in CI by default) ---
H1_LIVE_TEST=

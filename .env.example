# Anveshan — environment template
# Copy to .env and fill. Never commit .env.

# --- Database ---
DATABASE_URL=postgres://anveshan:anveshan@localhost:5433/anveshan

# --- HackerOne (Hacker API v1) ---
# https://hackerone.com/settings/api_token
HACKERONE_USERNAME=
HACKERONE_API_TOKEN=
# Base override (tests/staging only, default https://api.hackerone.com/v1/hackers)
H1_BASE_URL=https://api.hackerone.com/v1/hackers
H1_MIN_DELAY_MS=1500
H1_MAX_CONCURRENCY=1
H1_TIMEOUT_MS=15000

# --- Collection scheduler ---
COLLECTION_CRON=*/30 * * * *
COLLECTION_TZ=UTC
COLLECTION_ENABLED=true
# Mark collection_runs.status=running older than this as failed (default 2h)
COLLECTION_STALE_RUNNING_MS=7200000

# --- API ---
PORT=3000
LOG_LEVEL=info

# --- Milestone 2: notifications + magic-link auth ---
# Mail provider: smtp | brevo (factory selects the transport)
MAIL_PROVIDER=smtp
# SMTP (used when MAIL_PROVIDER=smtp; Gmail is local-only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Shared From address for every provider (Brevo: verified sender)
SMTP_FROM=noreply@anveshan.dev
# Brevo HTTP API (MAIL_PROVIDER=brevo)
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3
# Per-send mail budget in ms (default 30000). Raise if SMTP is slow.
MAIL_SEND_TIMEOUT_MS=30000
# Auth secrets (optional at boot; fail-closed per endpoint)
MAGIC_LINK_SECRET=
MAGIC_LINK_EXPIRY=900000
SESSION_SECRET=
SESSION_EXPIRY=2592000000
UNSUBSCRIBE_SECRET=
FRONTEND_URL=http://localhost:3001
NOTIFICATIONS_ENABLED=false
# AUTH_EMAIL_ENABLED unset = derived from provider credentials
# (smtp: SMTP_HOST+USER+PASS; brevo: BREVO_API_KEY)
AUTH_EMAIL_ENABLED=
# Per-minute tick for per-user digests (each user configures their own
# close time + timezone in Settings; defaults to 08:00 UTC).
DIGEST_TICK_CRON=* * * * *
IMMEDIATE_EMAIL_CAP=20
ASSET_EMAIL_CAP=10

# --- Live test gate (never enable in CI by default) ---
H1_LIVE_TEST=

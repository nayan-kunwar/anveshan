{
  "name": "anveshan",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --filter @anveshan/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:live": "cross-env H1_LIVE_TEST=1 vitest run --config vitest.live.config.ts",
    "collect": "pnpm --filter @anveshan/api collect",
    "db:generate": "pnpm --filter @anveshan/database db:generate",
    "db:migrate": "pnpm --filter @anveshan/database db:migrate",
    "db:studio": "pnpm --filter @anveshan/database db:studio",
    "commitlint": "commitlint --edit"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.7.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.6",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.2"
  }
}

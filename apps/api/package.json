{
  "name": "@anveshan/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx watch ./src/index.ts",
    "start": "node ./dist/index.js",
    "collect": "tsx ./src/collect.ts",
    "mail:test": "tsx ./src/mail-test.ts"
  },
  "dependencies": {
    "@anveshan/collector": "workspace:*",
    "@anveshan/config": "workspace:*",
    "@anveshan/database": "workspace:*",
    "@anveshan/domain": "workspace:*",
    "@anveshan/notifications": "workspace:*",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.0",
    "express": "^4.21.1",
    "node-cron": "^3.0.3",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.4",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.1"
  }
}
